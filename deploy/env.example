# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
# "anthropic" to use Claude; "offline" runs with no model spend.
WWOS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
WWOS_DEFAULT_MODEL=claude-opus-5-5
# Owner-authorised spending ceilings (USD per month).
WWOS_ORG_MONTHLY_BUDGET_USD=500
WWOS_MAX_AGENT_BUDGET_USD=100
WWOS_MAX_AGENTS_PER_TENANT=40
# Business policy: keep true until the owner decides agents may email clients directly.
WWOS_EXTERNAL_EMAIL_REQUIRES_APPROVAL=true
# Email delivery: "outbox" (no network) or "smtp".
WWOS_EMAIL_TRANSPORT=outbox
WWOS_SMTP_HOST=
WWOS_SMTP_PORT=587
WWOS_SMTP_USER=
WWOS_SMTP_PASSWORD=
WWOS_SMTP_FROM=
