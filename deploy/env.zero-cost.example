# Zero-cost profile: runs on your own computer, spends nothing.
# Copy to deploy/.env, set POSTGRES_PASSWORD, then follow docs/ZERO_COST_GUIDE.md.
WWOS_ENV=production
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# No AI: no model is ever called, all AI budgets are $0. The rules engine runs the business.
WWOS_LLM_PROVIDER=none
WWOS_ORG_MONTHLY_BUDGET_USD=0
WWOS_MAX_AGENT_BUDGET_USD=0

# E-mail: "manual" = approved e-mails wait on the dashboard for you to send yourself (no account needed).
# To send automatically through your own mailbox instead, set WWOS_EMAIL_TRANSPORT=smtp and the SMTP_* values
# (e.g. a Gmail app password). WWOS_EMAIL_DAILY_LIMIT keeps sending under your mailbox's daily limit.
WWOS_EMAIL_TRANSPORT=manual
WWOS_EMAIL_DAILY_LIMIT=100
WWOS_EXTERNAL_EMAIL_REQUIRES_APPROVAL=true
WWOS_SMTP_HOST=
WWOS_SMTP_PORT=587
WWOS_SMTP_SECURITY=starttls
WWOS_SMTP_USER=
WWOS_SMTP_PASSWORD=
WWOS_SMTP_FROM=

# The dashboard is reachable only from this computer (http://localhost:8000).
WWOS_PUBLIC_ORIGIN=http://localhost:8000
WWOS_COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1
