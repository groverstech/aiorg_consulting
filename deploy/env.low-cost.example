# $20/month AI profile: same as the zero-cost profile (your own computer, free e-mail options), plus
# Claude agents capped at $20 a month, paced across the month. See docs/ZERO_COST_GUIDE.md, "The $20 plan".
# Copy to deploy/.env, set POSTGRES_PASSWORD and ANTHROPIC_API_KEY, then run the `wwos ai-plan` step in the guide.
WWOS_ENV=production
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# AI on, Messages API runtime (lighter and cheaper than the optional Agent SDK runtime).
WWOS_LLM_PROVIDER=anthropic
WWOS_AGENT_RUNTIME=messages
ANTHROPIC_API_KEY=
# Hard cap: total AI spend in a calendar month can never exceed $20, whatever is approved in the app.
WWOS_HARD_MONTHLY_CAP_USD=20
# Default organisation budget, and the most any single agent can be given.
WWOS_ORG_MONTHLY_BUDGET_USD=20
WWOS_MAX_AGENT_BUDGET_USD=5
# Specialist agents the CEO creates default to the mid-priced model.
WWOS_DEFAULT_MODEL=claude-sonnet-5-5
# Spread the budget over the month: by day d, up to $20 x d/days-in-month + 25% ($5) can be used.
# Work beyond that waits until the next day instead of failing. Unused allowance carries forward.
WWOS_BUDGET_PACING_BURST_PCT=25
# Scheduled AI reviews weekly (the free rules-based briefing still runs every day).
WWOS_AI_REVIEW_CADENCE=weekly

# E-mail: as in the zero-cost profile.
WWOS_EMAIL_TRANSPORT=manual
WWOS_EMAIL_DAILY_LIMIT=100
WWOS_EXTERNAL_EMAIL_REQUIRES_APPROVAL=true
WWOS_SMTP_HOST=
WWOS_SMTP_PORT=587
WWOS_SMTP_SECURITY=starttls
WWOS_SMTP_USER=
WWOS_SMTP_PASSWORD=
WWOS_SMTP_FROM=

# The dashboard is reachable only from this computer (http://localhost:8000).
WWOS_PUBLIC_ORIGIN=http://localhost:8000
WWOS_COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1
