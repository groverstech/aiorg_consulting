{% extends "_base.html.j2" %}{% set doc_kind = "Daily briefing" %}{% set client_name = day %}
{% block body %}
<h1>Daily briefing &mdash; {{ day }}</h1>
<p class="meta">Prepared by the rules engine. AI: {{ ai }}. AI spend this month: ${{ ai_spend }}.</p>
<h2>Needs your decision</h2><ul>{% for a in approvals %}<li>{{ a.category }}: {{ a.count }}</li>{% else %}<li>Nothing pending.</li>{% endfor %}</ul>
<h2>Pipeline</h2><table><tr><th>Stage</th><th class="num">Deals</th><th class="num">Value</th></tr>
{% for p in pipeline %}<tr><td>{{ p.stage }}</td><td class="num">{{ p.count }}</td><td class="num">{{ p.value }}</td></tr>{% endfor %}</table>
<p>New contacts in the last 24 hours: {{ new_leads }}.</p>
<h2>Stalled deals (no activity for 7 days)</h2><ul>{% for d in stalled %}<li>{{ d.title }} &mdash; {{ d.stage }}, {{ d.value }}</li>{% else %}<li>None.</li>{% endfor %}</ul>
<p>Follow-up e-mails drafted for your approval: {{ followups }}.</p>
<h2>Partner pipeline</h2><ul>{% for p in partner_stages %}<li>{{ p.stage }}: {{ p.count }}</li>{% else %}<li>No partners recorded.</li>{% endfor %}</ul>
{% if stale_partners %}<p>Prospects without progress for 14 days: {{ stale_partners|join(", ") }}.</p>{% endif %}
<h2>Operations</h2><ul><li>Dead tasks (24 h): {{ ops.dead_tasks }}</li><li>Skipped tasks (AI off, 24 h): {{ ops.skipped_tasks }}</li>
<li>E-mails waiting for you to send by hand: {{ ops.emails_to_send_by_hand }}</li><li>E-mails needing reconciliation: {{ ops.emails_unknown_or_failed }}</li>
<li>Last QA scan: {{ qa }}</li></ul>
{% endblock %}
